<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <BenchmarkResultsRelativePath>bin\$(Configuration)\$(TargetFramework)\BenchmarkDotNet.Artifacts</BenchmarkResultsRelativePath>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup Label="benchmark artifacts">
        <None Include="$(BenchmarkResultsRelativePath)\**\*.*">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
            <Visible>true</Visible>
            <Link>(benchmark artifacts)\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>


      <None Remove="bin\Release\net10.0\BenchmarkDotNet.Artifacts\RunaString.Benchmark.Utf8RuneEnumeratorBenchmarkContext.RuneEnumerator-20260718-215308.etl" />
      <None Remove="bin\Release\net10.0\BenchmarkDotNet.Artifacts\RunaString.Benchmark.Utf8RuneEnumeratorBenchmarkContext.StandardCounting-20260718-194416.etl" />
